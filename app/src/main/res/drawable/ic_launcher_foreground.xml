<?xml version="1.0" encoding="utf-8"?>
<!-- Pausia mark: pearl liquid-glass open ring. The band wraps from -15deg to
     285deg (screen coords, gap at the upper right), pearlescent white with a
     mint wash toward the lower-left and a mint droplet near the upper tip.
     Content stays inside the adaptive icon safe zone (center 66dp circle). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Open ring band -->
    <path android:pathData="M79.11,47.27 A26,26 0 1,1 60.73,28.89 L57.62,40.48 A14,14 0 1,0 67.53,50.37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="78" android:startY="30"
                android:endX="32" android:endY="76">
                <item android:offset="0.0" android:color="#FFFDFDFB" />
                <item android:offset="0.42" android:color="#FFF2F3EC" />
                <item android:offset="0.75" android:color="#FFDFEDDF" />
                <item android:offset="1.0" android:color="#FFC9E4D0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft mint pool inside the band, lower-left -->
    <path android:pathData="M37.5,63.5 m-9.5,0 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="37.5" android:centerY="63.5"
                android:gradientRadius="10">
                <item android:offset="0.0" android:color="#66AEDCC0" />
                <item android:offset="1.0" android:color="#00AEDCC0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Glassy specular arcs -->
    <path
        android:pathData="M40.2,36.9 A21.5,21.5 0 0,1 66.9,32.6"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70.2,71.9 A21.5,21.5 0 0,1 33.4,64.6"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
    <!-- Mint droplet at the upper tip -->
    <path android:pathData="M61.0,29.3 m-3.3,0 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60" android:centerY="28.3"
                android:gradientRadius="4.6">
                <item android:offset="0.0" android:color="#FFEAF7EE" />
                <item android:offset="0.62" android:color="#FFBFE2CB" />
                <item android:offset="1.0" android:color="#FF9CCFAF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
