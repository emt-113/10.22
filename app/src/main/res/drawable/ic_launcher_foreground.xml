<?xml version="1.0" encoding="utf-8"?>
<!-- ScreenRhythm pearl planet: brand sphere (mint -> ice blue -> pearl pink ->
     lavender journey, same as the home hero material) with a tilted glass
     orbit, a satellite bead and star dust. Content stays inside the adaptive
     icon safe zone (center 66dp circle). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Planet sphere -->
    <path android:pathData="M54,34 a20,20 0 1,0 0.01,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36" android:startY="36"
                android:endX="72" android:endY="72">
                <item android:offset="0.0" android:color="#FF8FDCBE" />
                <item android:offset="0.34" android:color="#FFA9DDEC" />
                <item android:offset="0.67" android:color="#FFF7CFE0" />
                <item android:offset="1.0" android:color="#FFC9B4EE" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Key light on the upper-left of the sphere -->
    <path android:pathData="M46,36 a10,10 0 1,0 0.01,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="46" android:centerY="46"
                android:gradientRadius="11">
                <item android:offset="0.0" android:color="#99FFFFFF" />
                <item android:offset="0.55" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Pearl rim -->
    <path
        android:pathData="M54,34 a20,20 0 1,0 0.01,0 Z"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="0.9" />
    <!-- Tilted glass orbit + satellite -->
    <group
        android:rotation="-24"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:pathData="M27,54 a27,9.5 0 1,0 54,0 a27,9.5 0 1,0 -54,0"
            android:strokeColor="#8CFFFFFF"
            android:strokeWidth="1.6" />
        <path android:pathData="M81,54 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0"
            android:fillColor="#FFFFFFFF" />
    </group>
    <!-- Moon dot + star dust -->
    <path android:pathData="M76,32 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#E6FFFFFF" />
    <path android:pathData="M33,39 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0"
        android:fillColor="#8CFFFFFF" />
    <path android:pathData="M72,69 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"
        android:fillColor="#73FFFFFF" />
</vector>
